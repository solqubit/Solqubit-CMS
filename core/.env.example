APP_NAME=Solqubit
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Leave empty: session cookies become Secure automatically on HTTPS requests. Set to true to force it always.
SESSION_SECURE_COOKIE=
# Reverse proxies whose X-Forwarded-* headers are trusted (comma-separated IPs/CIDRs, or * only if the
# server is reachable exclusively through that proxy). Leave empty when PHP sees visitors directly or
# through nginx/Apache on the same server (CloudPanel, HestiaCP, Plesk): REMOTE_ADDR is already the client.
# Behind Cloudflare or a load balancer, list its address ranges so login limits use the real visitor IP.
SOLQUBIT_TRUSTED_PROXIES=
# GitHub repository (user/repo) trusted for updates. Keep it commented out to use the one recorded in the
# installed package; an empty value disables updates from GitHub.
# SOLQUBIT_UPDATE_REPOSITORY=usuario/repositorio
# Accept update ZIPs that are not published on GitHub (local development or private builds only).
# SOLQUBIT_ALLOW_UNVERIFIED=true
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
MAIL_MAILER=log
MAIL_FROM_ADDRESS=admin@example.com
MAIL_FROM_NAME=Solqubit
