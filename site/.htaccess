Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^solqubit-core(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\. - [F,L]

    # Mark versioned static files (?v= or ?id=) so they can be cached for a year.
    RewriteCond %{QUERY_STRING} (^|&)(v|id)=
    RewriteRule \.(css|js|mjs|woff2?|ttf|svg|png|jpe?g|webp|avif|gif|ico)$ - [E=SOLQUBIT_VERSIONED:1]

    # One address per page: drop the trailing slash.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^(?!index\.php$|install-core\.php$).*\.(php[0-9]?|phtml|phar)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(env|ini|log|sql|sqlite|zip|bak|json|ya?ml|lock)$">
    Require all denied
</FilesMatch>

# Compatible with Apache 2.4 and LiteSpeed (no <If> blocks).
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|mjs|woff2?|ttf|svg|png|jpe?g|webp|avif|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable" env=SOLQUBIT_VERSIONED
        Header set Cache-Control "public, max-age=3600" env=!SOLQUBIT_VERSIONED
    </FilesMatch>
</IfModule>
